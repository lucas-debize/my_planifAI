# ==============================================================================
# MyPlanifAI - Environment Variables Configuration
# ==============================================================================

# Supabase (Required in production - found in supabase.com -> Project Settings -> API)
# Example: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public "Anon Key" (Publishable Key)
# WARNING: NEVER put the "service_role" secret key here!
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the application (used to build OAuth redirect URLs and absolute links)
# Local: http://localhost:3000
# Production: https://your-project.vercel.app (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Offline local development bypass (without Supabase or Google OAuth)
# - Set to "1" to enable the offline local mock user dev@planifia.local (.data/dev-store.json)
# - Leave EMPTY in production (automatically disabled when NODE_ENV=production)
DEV_AUTH_BYPASS=

# AI Vision configurations for recipe import & handwritten weekly meal plan scanning
# 1. Cloudflare Workers AI (Recommended for high volume free tier, 10k daily neurons)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 2. Google Gemini Vision (Google AI Studio, fallback if Cloudflare is not configured)
GEMINI_API_KEY=

# 3. OpenAI Vision (e.g., gpt-4o-mini / gpt-4o)
OPENAI_API_KEY=

# 4. Zhipu / GLM Vision (e.g., glm-4.5v / glm-5.3-flash)
GLM_API_KEY=
