# ==============================================================================
# MyPlanifAI - Configuration des variables d'environnement
# ==============================================================================

# Supabase (obligatoire en production, récupéré depuis supabase.com -> Project Settings -> API)
# Exemple: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique Supabase "anon public key" (ou publishable key)
# Ne JAMAIS mettre la clé "service_role" ici !
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL publique de l'application (utilisée pour construire les URLs de redirection OAuth et liens)
# Local: http://localhost:3000
# Production Vercel: https://votre-projet.vercel.app (ou votre domaine personnalisé)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode développement hors-ligne sans Supabase ni Google OAuth
# - Mettre "1" pour activer le mock local dev@planifia.local (.data/dev-store.json)
# - Laisser STRICTEMENT VIDE en production (automatiquement ignoré si NODE_ENV=production)
DEV_AUTH_BYPASS=
